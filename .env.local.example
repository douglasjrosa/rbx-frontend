NEXT_PUBLIC_SITE_URL=https://ribermax.com.br

# Google Workspace SMTP (corporate email)
# REQUIRED: Google App Password (16 chars), NOT the normal login password.
# Create at https://myaccount.google.com/apppasswords (2-Step Verification on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rh@ribermax.com.br
SMTP_PASS=xxxx xxxx xxxx xxxx

# Optional overrides (defaults shown)
REPORT_TO_EMAIL=rh@ribermax.com.br
REPORT_FROM_EMAIL=rh@ribermax.com.br
